PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/staffsync  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>/staffsync
MONGODB_URI=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Initial HR administrator (used only by scripts/seedAdmin.js)
SEED_HR_NAME=HR Administrator
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
